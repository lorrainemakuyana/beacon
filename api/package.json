{
  "name": "@beacon/api",
  "version": "1.0.0",
  "description": "Beacon API - Firebase Cloud Functions",
  "main": "lib/index.js",
  "scripts": {
    "dev": "firebase emulators:start",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "@beacon/shared": "*",
    "firebase-admin": "^11.0.0",
    "firebase-functions": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "firebase-functions-test": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
