rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images
    match /users/{userId}/profile/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Incident photos - reporters and coordinators can access
    match /incidents/{incidentId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        // Allow incident reporter to upload
        resource.metadata.uploadedBy == request.auth.uid ||
        // Allow coordinators to view (validation would need to be done via Cloud Function)
        request.auth != null
      );
    }

    // Organization assets - organization members can read, owners can write
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        // This would need validation via Cloud Function to check organization ownership
        request.auth != null;
    }

    // Event assets - coordinators can manage
    match /events/{eventId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // Detailed permission checking would be handled by Cloud Functions
    }
  }
}